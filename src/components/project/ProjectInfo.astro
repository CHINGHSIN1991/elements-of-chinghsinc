---
/**
 * Key facts about a project as a definition list. Every value is either
 * meaningful on its own (date, names) or a link to drill down (category, tags).
 */
import { formatDate, toDateAttr, slugify } from '../../ts/utils';

interface Props {
  category: string;
  // `z.coerce.date()` in the content schema yields Date, not string.
  date: Date | string;
  designers?: string[];
  tags?: string[];
}

const { category, date, designers = [], tags = [] } = Astro.props as Props;
const dateObj = new Date(date);
const focusRing = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
---

<section aria-labelledby="project-details-title">
  <h2 id="project-details-title" class="font-display text-xs uppercase tracking-[0.25em] text-text-muted mb-4">Details</h2>
  <dl class="divide-y divide-border border-y border-border text-sm">
    <div class="grid grid-cols-[6rem_1fr] gap-4 py-3">
      <dt class="text-text-muted">Category</dt>
      <dd class="m-0">
        <a href={`/project/category/${slugify(category)}`} class={`text-text hover:text-primary underline-offset-4 hover:underline rounded-sm ${focusRing}`}>{category}</a>
      </dd>
    </div>
    <div class="grid grid-cols-[6rem_1fr] gap-4 py-3">
      <dt class="text-text-muted">Date</dt>
      <dd class="m-0 text-text tabular-nums">
        <time datetime={toDateAttr(dateObj)}>{formatDate(dateObj)}</time>
      </dd>
    </div>
    {designers.length > 0 && (
      <div class="grid grid-cols-[6rem_1fr] gap-4 py-3">
        <dt class="text-text-muted">{designers.length === 1 ? 'Designer' : 'Designers'}</dt>
        <dd class="m-0 text-text">{designers.join(', ')}</dd>
      </div>
    )}
    {tags.length > 0 && (
      <div class="grid grid-cols-[6rem_1fr] gap-4 py-3">
        <dt class="text-text-muted">Tags</dt>
        <dd class="m-0">
          <ul class="flex flex-wrap gap-2 list-none m-0 p-0">
            {tags.map((tag) => (
              <li>
                <a
                  href={`/project/tag/${slugify(tag)}`}
                  class={`inline-flex items-center min-h-8 px-3 rounded-full bg-background-tertiary text-xs text-text-secondary hover:bg-primary hover:text-white transition-colors ${focusRing}`}
                >
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        </dd>
      </div>
    )}
  </dl>
</section>
