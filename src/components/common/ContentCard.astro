---
import Card from "./Card.astro";

interface Tag {
  label: string;
  href: string;
}

interface Cta {
  label: string;
  href: string;
}

interface ImageMeta {
  src: string;
  alt: string;
}

interface Props {
  href: string;
  title: string;
  time?: string;
  /** Machine-readable date for <time datetime>. */
  dateTime?: string;
  description?: string;
  image: ImageMeta;
  category?: string;
  tags?: Tag[];
  cta?: Cta;
  class?: string;
}

const {
  href,
  title,
  time,
  dateTime,
  description,
  image,
  category,
  tags = [],
  cta,
  class: customClass = "",
} = Astro.props as Props;

const focusRing = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
---

<Card class={customClass}>
  <a slot="image" href={href} class={`block relative overflow-hidden rounded-md ${focusRing}`} tabindex="-1" aria-hidden="true">
    <!-- 16:9 box reserves space before the image loads (no layout shift). -->
    <div class="aspect-video overflow-hidden bg-background-tertiary">
      <img
        src={image.src}
        alt=""
        width="1200"
        height="675"
        class="object-cover w-full h-full motion-safe:transition-transform motion-safe:duration-500 group-hover:scale-[1.03]"
        loading="lazy"
        decoding="async"
      />
    </div>

    {category && (
      <span class="label absolute top-4 left-4 px-3 py-1">
        {category}
      </span>
    )}
  </a>

  {time && (
    <time slot="time" datetime={dateTime}>{time}</time>
  )}

  <h2 slot="title" class="font-display text-xl font-medium leading-snug mb-2 text-text">
    <a href={href} class={`block rounded-sm group-hover:text-primary transition-colors ${focusRing}`}>
      {title}
    </a>
  </h2>

  {description && (
    <p slot="description" class="text-text-secondary text-sm leading-relaxed line-clamp-2 mb-4">
      {description}
    </p>
  )}

  <div slot="actions">
    {tags.length > 0 && (
      <ul class="flex flex-wrap gap-2 mb-2 list-none p-0 m-0" aria-label="Tags">
        {tags.slice(0, 3).map((tag) => (
          <li>
            <a
              href={tag.href}
              class={`inline-flex items-center min-h-8 text-xs px-3 rounded-full bg-background-tertiary text-text-secondary hover:bg-primary hover:text-white transition-colors ${focusRing}`}
            >
              #{tag.label}
            </a>
          </li>
        ))}
      </ul>
    )}

    {cta && (
      <a
        href={cta.href}
        class={`inline-flex items-center gap-1 min-h-11 px-4 rounded-full bg-primary text-white hover:bg-primary-dark transition-colors font-medium text-sm ${focusRing}`}
      >
        {cta.label}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 motion-safe:transition-transform group-hover:translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
          focusable="false"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    )}
  </div>
</Card>
