---
import { slugify, formatDate, toDateAttr, sortAndLimit, getPublishedCollection, type ContentCollectionKey } from "../../ts/utils";

interface Props {
  collectionName: ContentCollectionKey;
  linkPrefix: string;
  limit?: number;
  heading?: string;
}

const { collectionName, linkPrefix, limit = 5, heading } = Astro.props as Props;

const allItems = await getPublishedCollection(collectionName);

// Newest first — the list is sorted by date, so label it as such.
const latestItems = sortAndLimit(allItems, limit);
const title = heading ?? `Latest ${collectionName.charAt(0).toUpperCase() + collectionName.slice(1)}`;
---

{latestItems.length > 0 && (
  <section aria-label={title}>
    <h2 class="font-display text-xs uppercase tracking-[0.25em] text-text-muted mb-4">{title}</h2>
    <ul class="space-y-1 list-none m-0 p-0">
      {latestItems.map(item => (
        <li>
          <a
            href={`${linkPrefix}/${item.id || slugify(item.data.title)}`}
            class="block -mx-2 px-2 py-2 rounded-md hover:bg-background-secondary transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            <span class="block text-sm text-text-secondary line-clamp-2">{item.data.title}</span>
            <time datetime={toDateAttr(item.data.date)} class="mt-1 block text-xs text-text-muted tabular-nums">
              {formatDate(new Date(item.data.date))}
            </time>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
