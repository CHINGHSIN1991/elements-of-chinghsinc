---
/**
 * Shared header for listing pages (all / category / tag).
 * eyebrow → h1 → description, with a slot for filters or actions below.
 */
interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  /** Rendered next to the title, e.g. an item count. */
  meta?: string;
  class?: string;
}

const { title, eyebrow, description, meta, class: className = '' } = Astro.props as Props;
---

<header class={`mb-10 md:mb-12 ${className}`}>
  {eyebrow && (
    <p class="font-display text-xs uppercase tracking-[0.3em] text-primary mb-3">{eyebrow}</p>
  )}
  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
    <h1 class="font-display text-3xl md:text-5xl font-medium tracking-tight text-text">{title}</h1>
    {meta && <p class="text-sm text-text-muted tabular-nums">{meta}</p>}
  </div>
  {description && (
    <p class="mt-4 max-w-2xl text-lg text-text-secondary leading-relaxed">{description}</p>
  )}
  <slot />
</header>
