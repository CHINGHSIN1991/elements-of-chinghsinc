---
import { Icon } from 'astro-icon/components';

interface Props {
  class?: string;
}

const { class: customClass = "" } = Astro.props;
---

<section class={customClass} aria-labelledby="support-title">
  <h2 id="support-title" class="font-display text-xs uppercase tracking-[0.25em] text-text-muted mb-4">Support</h2>
  <a
    href="https://buymeacoffee.com/chinghsinc"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 min-h-11 px-5 rounded-full border border-border text-sm font-medium text-text hover:border-primary hover:text-primary transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
  >
    <Icon name="lets-icons:drink-light" class="w-5 h-5" aria-hidden="true" />
    Buy me a coffee
    <span class="sr-only">(opens in a new tab)</span>
  </a>
</section>
