---
import { slugify, getPublishedCollection, type ContentCollectionKey } from "../../ts/utils";

interface Props {
  collectionName: ContentCollectionKey;
  heading: string;
  basePath: string;
  currentCategory?: string;
}

const { collectionName, heading, basePath, currentCategory } = Astro.props as Props;

const allItems = await getPublishedCollection(collectionName);

const categories = [...new Set(allItems.map(item => item.data.category))];

const categoryCounts = categories.reduce((acc, category) => {
  const count = allItems.filter(item => item.data.category === category).length;
  return {
    ...acc,
    [category]: count
  };
}, {} as Record<string, number>);
---
{categories.length > 0 && (
<nav aria-label={heading}>
  <h2 class="font-display text-xs uppercase tracking-[0.25em] text-text-muted mb-4">{heading}</h2>
  <ul class="space-y-1 list-none m-0 p-0">
    {categories.map(cat => {
      const active = cat === currentCategory;
      return (
        <li>
          <a
            href={`${basePath}/category/${slugify(cat)}`}
            aria-current={active ? 'page' : undefined}
            class={`flex items-center justify-between gap-3 -mx-2 px-2 min-h-10 rounded-md text-sm transition-colors duration-200 hover:bg-background-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary ${
              active ? 'text-primary font-medium' : 'text-text-secondary hover:text-text'
            }`}
          >
            <span>{cat}</span>
            <span class="text-xs tabular-nums text-text-muted">{categoryCounts[cat]}</span>
          </a>
        </li>
      );
    })}
  </ul>
</nav>
)}
