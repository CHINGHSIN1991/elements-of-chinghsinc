---
const { class: customClass = "" } = Astro.props;
---
<article
  class={`card group h-full flex flex-col overflow-hidden rounded-2xl border border-border bg-background-secondary motion-safe:transition-[transform,border-color,box-shadow] motion-safe:duration-300 hover:border-primary hover:shadow-md motion-safe:hover:-translate-y-1 ${customClass}`}
>
  <slot name="image" />
  <div class="p-5 md:p-6 flex-grow flex flex-col">
    <div class="mb-auto">
      <div class="flex items-center text-text-muted text-sm mb-2 tabular-nums">
        <slot name="time" />
      </div>
      <slot name="title" />
      <slot name="description" />
    </div>
    <div class="mt-4">
      <slot name="actions" />
    </div>
  </div>
</article>
