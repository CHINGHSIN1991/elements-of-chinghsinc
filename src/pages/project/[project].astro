---
import { type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { slugify, sortAndLimit, getPublishedCollection } from '../../ts/utils';
import MainLayout from '../../layouts/MainLayout.astro';
import RelatedItems from '../../components/common/RelatedItems.astro';
import ProjectInfo from '../../components/project/ProjectInfo.astro';
import PostHeader from '../../components/layout/PostHeader.astro';
import BuyMeACoffee from '../../components/common/BuyMeACoffee.astro';

export const prerender = true;

export async function getStaticPaths() {
  // Newest first, so "next" walks back in time like the listing grid.
  const allProjects = sortAndLimit(await getPublishedCollection('projects'));

  return allProjects.map((project, i) => ({
    params: { project: project.id || slugify(project.data.title) },
    props: {
      project,
      newer: allProjects[i - 1],
      older: allProjects[i + 1],
    },
  }));
}

interface ProjectPageProps {
  project: CollectionEntry<'projects'>;
  newer?: CollectionEntry<'projects'>;
  older?: CollectionEntry<'projects'>;
}

const { project, newer, older } = Astro.props as ProjectPageProps;
const { data } = project;
const dateObj = new Date(data.date);
const coverData = typeof data.cover === 'string' && data.cover
  ? { src: data.cover, alt: data.title || '專案封面' }
  : undefined;

const projectHref = (p: CollectionEntry<'projects'>) => `/project/${p.id || slugify(p.data.title)}`;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Projects', href: '/project' },
  { label: data.category, href: `/project/category/${slugify(data.category)}` },
  { label: data.title },
];

const focusRing = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
const navCard = `group flex flex-col gap-1 rounded-2xl border border-border bg-background-secondary p-5 min-h-24 hover:border-primary transition-colors duration-200 ${focusRing}`;
---

<MainLayout title={data.title} description={data.description} image={coverData} project={data}>
  <article>
    <PostHeader
      title={data.title}
      description={data.description}
      date={dateObj}
      category={data.category}
      designers={data.designers || []}
      cover={coverData}
      categoryBasePath="/project/category"
      breadcrumbs={breadcrumbs}
    />

    <div class="container py-12 md:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_18rem] gap-12 xl:gap-16">
        <!-- Main column -->
        <div class="min-w-0 max-w-3xl">
          <section id="overview" aria-labelledby="overview-title" class="mb-14">
            <h2 id="overview-title" class="font-display text-xs uppercase tracking-[0.25em] text-primary mb-4">Overview</h2>
            <p class="text-lg md:text-xl text-text leading-relaxed">
              {data.description}
            </p>
          </section>

          {data.images && data.images.length > 0 && (
            <section id="gallery" aria-labelledby="gallery-title">
              <h2 id="gallery-title" class="font-display text-xs uppercase tracking-[0.25em] text-primary mb-6">
                Gallery <span class="text-text-muted normal-case tracking-normal ml-2 tabular-nums">{data.images.length} images</span>
              </h2>
              <ol class="space-y-10 list-none m-0 p-0">
                {data.images.map((image: { src: string; description?: string }, i: number) => (
                  <li>
                    <figure class="m-0">
                      <!-- aspect box reserves space; lazy below the fold -->
                      <div class="aspect-video overflow-hidden rounded-2xl border border-border bg-background-tertiary">
                        <img
                          src={image.src}
                          alt={image.description || `${data.title} — image ${i + 1}`}
                          width="1200"
                          height="675"
                          class="w-full h-full object-cover"
                          loading={i === 0 ? 'eager' : 'lazy'}
                          decoding="async"
                        />
                      </div>
                      {image.description && (
                        <figcaption class="mt-3 flex gap-3 text-sm text-text-secondary leading-relaxed">
                          <span class="font-display text-text-muted tabular-nums shrink-0">{String(i + 1).padStart(2, '0')}</span>
                          <span>{image.description}</span>
                        </figcaption>
                      )}
                    </figure>
                  </li>
                ))}
              </ol>
            </section>
          )}
        </div>

        <!-- Sidebar -->
        <aside class="min-w-0">
          <div class="lg:sticky lg:top-24 space-y-10">
            <ProjectInfo
              category={data.category}
              date={data.date}
              designers={data.designers}
              tags={data.tags}
            />
            <RelatedItems currentItem={project} collection="projects" linkPrefix="/project" limit={3} heading="More projects" />
            <BuyMeACoffee />
          </div>
        </aside>
      </div>

      <!-- Previous / next project -->
      {(newer || older) && (
        <nav aria-label="Project navigation" class="mt-16 pt-10 border-t border-border grid grid-cols-1 sm:grid-cols-2 gap-4">
          {newer ? (
            <a href={projectHref(newer)} rel="prev" class={navCard}>
              <span class="inline-flex items-center gap-1 text-xs uppercase tracking-[0.2em] text-text-muted">
                <Icon name="lets-icons:expand-left-light" class="w-4 h-4" aria-hidden="true" />
                Newer
              </span>
              <span class="font-display text-lg font-medium text-text group-hover:text-primary transition-colors">{newer.data.title}</span>
            </a>
          ) : <span aria-hidden="true"></span>}
          {older && (
            <a href={projectHref(older)} rel="next" class={`${navCard} sm:text-right sm:items-end`}>
              <span class="inline-flex items-center gap-1 text-xs uppercase tracking-[0.2em] text-text-muted">
                Older
                <Icon name="lets-icons:expand-right-light" class="w-4 h-4" aria-hidden="true" />
              </span>
              <span class="font-display text-lg font-medium text-text group-hover:text-primary transition-colors">{older.data.title}</span>
            </a>
          )}
        </nav>
      )}

      <div class="mt-10 flex justify-center">
        <a
          href="#main-content"
          class={`inline-flex items-center gap-2 min-h-11 px-5 rounded-full text-sm text-text-muted hover:text-text transition-colors ${focusRing}`}
        >
          <Icon name="lets-icons:expand-up-light" class="w-5 h-5" aria-hidden="true" />
          Back to top
        </a>
      </div>
    </div>
  </article>
</MainLayout>
