---
import MainLayout from '../../layouts/MainLayout.astro';
import Pagination from '../../components/common/Pagination.astro';
import PageHeader from '../../components/common/PageHeader.astro';
import CategoryFilter from '../../components/common/CategoryFilter.astro';
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPathsOptions, Page } from 'astro';
import { getPublishedCollection, sortAndLimit, type ContentCollectionKey } from '../../ts/utils';

export function createGetStaticPaths(collectionName: ContentCollectionKey, pageSize = 6) {
  return async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const allItems = await getPublishedCollection(collectionName);
    // Newest first — glob order is alphabetical by filename, not chronological.
    return paginate(sortAndLimit(allItems), { pageSize });
  };
}

// Astro component factories don't have a clean public type; using a named
// alias here documents intent and can be updated when Astro exposes AstroComponentFactory.
// eslint-disable-next-line @typescript-eslint/no-explicit-any
type AstroComponentLike = (...args: any[]) => unknown;

interface PaginatedListProps<T extends ContentCollectionKey = ContentCollectionKey> {
  collectionName: ContentCollectionKey;
  cardComponent: AstroComponentLike;
  sidebarComponents: Array<{ component: AstroComponentLike; props?: Record<string, unknown> }>;
  page: Page<CollectionEntry<T>>;
  title?: string;
  eyebrow?: string;
  description?: string;
}

const COPY: Record<ContentCollectionKey, { title: string; eyebrow: string; description: string; unit: string; basePath: string }> = {
  projects: {
    title: 'Projects',
    eyebrow: 'Work',
    description: 'Selected case studies across product, interface and spatial design — filter by category or browse the full archive.',
    unit: 'projects',
    basePath: '/project',
  },
  posts: {
    title: 'Blog',
    eyebrow: 'Journal',
    description: 'Notes on design, engineering and the space between them.',
    unit: 'posts',
    basePath: '/blog',
  },
};

const {
  collectionName,
  cardComponent: CardComponent,
  sidebarComponents = [],
  page,
  title,
  eyebrow,
  description,
} = Astro.props as PaginatedListProps;

const copy = COPY[collectionName];
const itemPropName = collectionName.endsWith('s') ? collectionName.slice(0, -1) : 'item';
const gridClass = collectionName === 'projects'
  ? 'grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6'
  : 'grid grid-cols-1 lg:grid-cols-2 gap-6';

const total = page?.total ?? page?.data?.length ?? 0;
const meta = total > 0 ? `${total} ${copy.unit}` : undefined;
---

<MainLayout title={title ?? copy.title} description={description ?? copy.description}>
  <section class="container py-12 md:py-16">
    <PageHeader
      title={title ?? copy.title}
      eyebrow={eyebrow ?? copy.eyebrow}
      description={description ?? copy.description}
      meta={meta}
    >
      <CategoryFilter collectionName={collectionName} basePath={copy.basePath} class="mt-8" />
    </PageHeader>

    <div class="grid grid-cols-1 lg:grid-cols-[14rem_1fr] gap-10 xl:gap-14">
      <aside class="hidden lg:block">
        <div class="sticky-navbar-safe space-y-10">
          {sidebarComponents.map(({ component: Component, props }) => (
            <Component {...props} />
          ))}
        </div>
      </aside>

      <div class="min-w-0">
        {page && page.data?.length > 0 ? (
          <>
            <div class={gridClass}>
              {page.data.map(item => (
                <CardComponent {...{ [itemPropName]: item }} />
              ))}
            </div>

            <div class="mt-12">
              <Pagination
                prevUrl={page.url.prev}
                nextUrl={page.url.next}
                currentPage={page.currentPage}
                lastPage={page.lastPage}
              />
            </div>
          </>
        ) : (
          <div class="flex flex-col items-center justify-center text-center py-20 px-6 rounded-2xl border border-border bg-background-secondary">
            <span class="inline-flex w-12 h-12 items-center justify-center rounded-xl bg-[color-mix(in_srgb,var(--color-primary)_12%,transparent)] text-primary mb-5">
              <Icon name="lets-icons:folder-open-light" class="w-6 h-6" aria-hidden="true" />
            </span>
            <h2 class="font-display text-2xl font-medium text-text mb-2">
              尚無{collectionName === 'posts' ? '文章' : '專案'}
            </h2>
            <p class="max-w-md text-text-secondary mb-8">
              目前尚未有任何{collectionName === 'posts' ? '文章' : '專案作品'}，請稍後再查看。
            </p>
            <a
              href={import.meta.env.BASE_URL}
              class="inline-flex items-center gap-2 min-h-11 px-6 rounded-full bg-primary text-white font-medium hover:bg-primary-dark transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              返回首頁
            </a>
          </div>
        )}
      </div>
    </div>
  </section>
</MainLayout>
