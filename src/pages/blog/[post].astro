---
import { render, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import PostLayout from '../../layouts/PostLayout.astro';
import RelatedItems from '../../components/common/RelatedItems.astro';
import TagList from '../../components/common/TagList.astro';
import BuyMeACoffee from '../../components/common/BuyMeACoffee.astro';
import TableOfContents from '../../components/blog/TableOfContents.astro';
import { slugify, sortAndLimit, getPublishedCollection } from '../../ts/utils';

export const prerender = true;

export async function getStaticPaths() {
  // Newest first, so "older" walks back in time like the listing.
  const allPosts = sortAndLimit(await getPublishedCollection('posts'));
  return allPosts.map((post, i) => ({
    params: { post: post.id },
    props: {
      post,
      newer: allPosts[i - 1],
      older: allPosts[i + 1],
    },
  }));
}

interface PostPageProps {
  post: CollectionEntry<'posts'>;
  newer?: CollectionEntry<'posts'>;
  older?: CollectionEntry<'posts'>;
}

const { post, newer, older } = Astro.props as PostPageProps;

if (!post) {
  return Astro.redirect('/404');
}

const { Content, headings } = await render(post);

// Reading time: CJK is read per character, Latin per word.
const body = post.body ?? '';
const cjkChars = (body.match(/[㐀-鿿豈-﫿]/g) ?? []).length;
const latinWords = body
  .replace(/[㐀-鿿豈-﫿]/g, ' ')
  .split(/\s+/)
  .filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(cjkChars / 350 + latinWords / 220));

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

const focusRing = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
const navCard = `group flex flex-col gap-1 rounded-2xl border border-border bg-background-secondary p-5 min-h-24 hover:border-primary transition-colors duration-200 ${focusRing}`;
---

<PostLayout post={post}>
  <div class="container py-12 md:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_18rem] gap-12 xl:gap-16">
      <!-- Article -->
      <div class="min-w-0 max-w-3xl">
        <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-text-muted mb-8">
          <span class="inline-flex items-center gap-1.5">
            <Icon name="lets-icons:time-light" class="w-4 h-4" aria-hidden="true" />
            {readingMinutes} min read
          </span>
          <span aria-hidden="true">·</span>
          <span>{tocHeadings.filter((h) => h.depth === 2).length} sections</span>
        </p>

        {tocHeadings.length > 0 && (
          <details class="lg:hidden mb-10 rounded-2xl border border-border bg-background-secondary open:pb-2">
            <summary class={`flex items-center justify-between gap-3 cursor-pointer list-none min-h-12 px-5 font-medium text-text rounded-2xl ${focusRing} [&::-webkit-details-marker]:hidden`}>
              On this page
              <Icon name="lets-icons:expand-down-light" class="w-5 h-5 text-text-muted transition-transform duration-200 [details[open]_&]:rotate-180" aria-hidden="true" />
            </summary>
            <div class="px-5 pt-1">
              <TableOfContents headings={headings} heading="" />
            </div>
          </details>
        )}

        <div class="prose dark:prose-invert max-w-none text-[1.0625rem] md:text-lg leading-relaxed">
          <Content />
        </div>

        {post.data.tags && post.data.tags.length > 0 && (
          <footer class="mt-14 pt-8 border-t border-border">
            <h2 class="font-display text-xs uppercase tracking-[0.25em] text-text-muted mb-4">Tags</h2>
            <TagList tags={post.data.tags} basePath="/blog/tag" />
          </footer>
        )}
      </div>

      <!-- Sidebar -->
      <aside class="min-w-0">
        <div class="lg:sticky lg:top-24 space-y-10">
          <TableOfContents headings={headings} class="hidden lg:block" />
          <RelatedItems currentItem={post} collection="posts" linkPrefix="/blog" limit={3} heading="More posts" />
          <BuyMeACoffee />
        </div>
      </aside>
    </div>

    <!-- Previous / next post -->
    {(newer || older) && (
      <nav aria-label="Post navigation" class="mt-16 pt-10 border-t border-border grid grid-cols-1 sm:grid-cols-2 gap-4">
        {newer ? (
          <a href={`/blog/${newer.id}`} rel="prev" class={navCard}>
            <span class="inline-flex items-center gap-1 text-xs uppercase tracking-[0.2em] text-text-muted">
              <Icon name="lets-icons:expand-left-light" class="w-4 h-4" aria-hidden="true" />
              Newer
            </span>
            <span class="font-display text-lg font-medium text-text group-hover:text-primary transition-colors">{newer.data.title}</span>
          </a>
        ) : <span aria-hidden="true"></span>}
        {older && (
          <a href={`/blog/${older.id}`} rel="next" class={`${navCard} sm:text-right sm:items-end`}>
            <span class="inline-flex items-center gap-1 text-xs uppercase tracking-[0.2em] text-text-muted">
              Older
              <Icon name="lets-icons:expand-right-light" class="w-4 h-4" aria-hidden="true" />
            </span>
            <span class="font-display text-lg font-medium text-text group-hover:text-primary transition-colors">{older.data.title}</span>
          </a>
        )}
      </nav>
    )}

    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a
        href={`/blog/category/${slugify(post.data.category)}`}
        class={`inline-flex items-center gap-2 min-h-11 px-5 rounded-full border border-border text-sm font-medium text-text hover:border-primary hover:text-primary transition-colors ${focusRing}`}
      >
        <Icon name="lets-icons:expand-left-light" class="w-5 h-5" aria-hidden="true" />
        More in {post.data.category}
      </a>
      <a
        href="#main-content"
        class={`inline-flex items-center gap-2 min-h-11 px-5 rounded-full text-sm text-text-muted hover:text-text transition-colors ${focusRing}`}
      >
        <Icon name="lets-icons:expand-up-light" class="w-5 h-5" aria-hidden="true" />
        Back to top
      </a>
    </div>
  </div>
</PostLayout>

<style is:global>
  /* Article typography: display face for headings, token colours for text. */
  .prose {
    --un-prose-body: var(--color-text);
    --un-prose-headings: var(--color-text);
    --un-prose-links: var(--color-primary);
    --un-prose-lists: var(--color-text-secondary);
    --un-prose-hr: var(--color-border);
    --un-prose-captions: var(--color-text-muted);
    --un-prose-code: var(--color-text);
    --un-prose-borders: var(--color-border);
    --un-prose-bg-soft: var(--color-background-secondary);
  }
  .prose :is(h2, h3, h4) {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .prose a {
    text-underline-offset: 4px;
  }
  .prose img {
    border-radius: 1rem;
  }
</style>
