---
import BaseContentLayout from "./BaseContentLayout.astro";
import PostHeader from "../components/layout/PostHeader.astro";
import { slugify } from "../ts/utils";

interface PostFrontmatter {
  draft: boolean;
  title: string;
  description: string;
  date: Date;
  category: string;
  author?: string;
  designers?: string[];
  image?: {
    src: string;
    alt: string;
  };
  images?: {
    src: string;
    alt: string;
  }[];
}

const { post } = Astro.props;

const {
  title,
  description,
  date,
  category,
  author,
  designers,
  image,
  images,
} = post.data as PostFrontmatter;

// 處理 cover 屬性
const coverData = image ? { src: image.src, alt: image.alt || title } : undefined;
// Posts carry a single `author`; projects carry `designers`. Show whichever exists.
const byline = designers?.length ? designers : author ? [author] : [];
---

<BaseContentLayout {title} {description} image={coverData} {images} post={post.data}>
  <article>
    <PostHeader
      {title} {description} {date} {category} cover={coverData} designers={byline}
      categoryBasePath="/blog/category"
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'Blog', href: '/blog' },
        { label: category, href: `/blog/category/${slugify(category)}` },
        { label: title },
      ]}
    />
    <slot />
  </article>
</BaseContentLayout>
